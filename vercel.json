{
  "version": 2,
  "builds": [
    {
      "src": "backend/src/server.js",
      "use": "@vercel/node"
    },
    {
      "src": "Frontend/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "backend/src/server.js"
    },
    {
      "src": "/user/books",
      "dest": "/Frontend/books.html"
    },
    {
      "src": "/user/dashboard",
      "dest": "/Frontend/dashboard.html"
    },
    {
      "src": "/user/profile",
      "dest": "/Frontend/profile.html"
    },
    {
      "src": "/user/(.*)",
      "dest": "/Frontend/$1.html"
    },
    {
      "src": "/(login|signup|dashboard|books|book-add-edit|book-view|authors|author-add-edit|genres|genre-add-edit|profile)(\\.html)?",
      "dest": "/Frontend/$1"
    },
    {
      "src": "/$",
      "dest": "/Frontend/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/Frontend/$1"
    }
  ]
}